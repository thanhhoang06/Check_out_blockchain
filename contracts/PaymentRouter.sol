pragma solidity ^0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {EIP712} from "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";

/**
 * @title PaymentRouter
 * @notice Universal Checkout Payment Router on Avalanche Fuji C-Chain.
 * @dev Handles non-custodial, direct ERC-20 (USDC) payments from buyer to merchant
 *      validated via backend EIP-712 signed PaymentIntent.
 */
contract PaymentRouter is EIP712, ReentrancyGuard, Ownable {
    using SafeERC20 for IERC20;

    /// @notice PaymentIntent struct definition matching backend specification
    struct PaymentIntent {
        bytes32 paymentId;
        address buyer;
        address merchant;
        address token;
        uint256 amount;
        uint256 deadline;
    }

    /// @notice EIP-712 typehash for PaymentIntent
    bytes32 public constant PAYMENT_INTENT_TYPEHASH = keccak256(
        "PaymentIntent(bytes32 paymentId,address buyer,address merchant,address token,uint256 amount,uint256 deadline)"
    );

    /// @notice Address authorized to sign PaymentIntents
    address public backendSigner;

    /// @notice Mapping to ensure each paymentId can only be executed once (replay protection)
    mapping(bytes32 => bool) public executedPayments;

    /// @notice Whitelist of accepted tokens (e.g. Fuji USDC)
    mapping(address => bool) public allowedTokens;

    // --- Custom Errors for Gas Efficiency and Clarity ---
    error ZeroAddress();
    error PaymentExpired(uint256 deadline, uint256 currentTimestamp);
    error PaymentAlreadyExecuted(bytes32 paymentId);
    error InvalidBuyer(address expectedBuyer, address actualBuyer);
    error InvalidMerchant(address merchant);
    error InvalidAmount(uint256 amount);
    error UnsupportedToken(address token);
    error InvalidSigner(address recoveredSigner, address expectedSigner);

    // --- Events ---
    event PaymentReceived(
        bytes32 indexed paymentId,
        address indexed buyer,
        address indexed merchant,
        address token,
        uint256 amount
    );

    event BackendSignerUpdated(address indexed oldSigner, address indexed newSigner);
    event TokenSupportUpdated(address indexed token, bool allowed);

    /**
     * @param _backendSigner The address authorized to sign PaymentIntents
     * @param _initialOwner The owner/admin of the contract
     * @param _initialToken Initial allowed token address (e.g. Fuji USDC)
     */
    constructor(
        address _backendSigner,
        address _initialOwner,
        address _initialToken
    ) EIP712("UniversalCheckout", "1") Ownable(_initialOwner) {
        if (_backendSigner == address(0) || _initialOwner == address(0)) {
            revert ZeroAddress();
        }
        backendSigner = _backendSigner;
        emit BackendSignerUpdated(address(0), _backendSigner);

        if (_initialToken != address(0)) {
            allowedTokens[_initialToken] = true;
            emit TokenSupportUpdated(_initialToken, true);
        }
    }

    /**
     * @notice Executes payment using a valid EIP-712 signed PaymentIntent.
     * @param intent The payment intent containing payment details.
     * @param signature The EIP-712 signature generated by backendSigner.
     */
    function pay(
        PaymentIntent calldata intent,
        bytes calldata signature
    ) external nonReentrant {
        // 1. Check expiration
        if (block.timestamp > intent.deadline) {
            revert PaymentExpired(intent.deadline, block.timestamp);
        }

        // 2. Enforce caller is buyer
        if (msg.sender != intent.buyer) {
            revert InvalidBuyer(intent.buyer, msg.sender);
        }

        // 3. Check merchant address validity
        if (intent.merchant == address(0)) {
            revert InvalidMerchant(address(0));
        }

        // 4. Check amount
        if (intent.amount == 0) {
            revert InvalidAmount(0);
        }

        // 5. Check token is whitelisted
        if (!allowedTokens[intent.token]) {
            revert UnsupportedToken(intent.token);
        }

        // 6. Check paymentId has not been executed previously
        if (executedPayments[intent.paymentId]) {
            revert PaymentAlreadyExecuted(intent.paymentId);
        }

        // 7. Verify EIP-712 signature from backendSigner
        bytes32 structHash = keccak256(
            abi.encode(
                PAYMENT_INTENT_TYPEHASH,
                intent.paymentId,
                intent.buyer,
                intent.merchant,
                intent.token,
                intent.amount,
                intent.deadline
            )
        );

        bytes32 digest = _hashTypedDataV4(structHash);
        address recoveredSigner = ECDSA.recover(digest, signature);
        if (recoveredSigner != backendSigner || recoveredSigner == address(0)) {
            revert InvalidSigner(recoveredSigner, backendSigner);
        }

        // 8. Effect: Mark paymentId as executed BEFORE external transfer (Checks-Effects-Interactions)
        executedPayments[intent.paymentId] = true;

        // 9. Interaction: Direct transferFrom buyer to merchant (Non-custodial)
        IERC20(intent.token).safeTransferFrom(intent.buyer, intent.merchant, intent.amount);

        // 10. Emit event for backend verification
        emit PaymentReceived(
            intent.paymentId,
            intent.buyer,
            intent.merchant,
            intent.token,
            intent.amount
        );
    }

    /**
     * @notice Helper to compute the EIP-712 digest for a given PaymentIntent.
     * @param intent The PaymentIntent to hash.
     * @return The 32-byte EIP-712 digest.
     */
    function getPaymentIntentDigest(PaymentIntent calldata intent) external view returns (bytes32) {
        bytes32 structHash = keccak256(
            abi.encode(
                PAYMENT_INTENT_TYPEHASH,
                intent.paymentId,
                intent.buyer,
                intent.merchant,
                intent.token,
                intent.amount,
                intent.deadline
            )
        );
        return _hashTypedDataV4(structHash);
    }

    /**
     * @notice Admin function to update the backend signer.
     */
    function setBackendSigner(address _newSigner) external onlyOwner {
        if (_newSigner == address(0)) {
            revert ZeroAddress();
        }
        address oldSigner = backendSigner;
        backendSigner = _newSigner;
        emit BackendSignerUpdated(oldSigner, _newSigner);
    }

    /**
     * @notice Admin function to whitelist or delist a token.
     */
    function setTokenSupport(address _token, bool _allowed) external onlyOwner {
        if (_token == address(0)) {
            revert ZeroAddress();
        }
        allowedTokens[_token] = _allowed;
        emit TokenSupportUpdated(_token, _allowed);
    }
}
